# Copy to .env and fill in. Never commit .env.
# All values are optional; the pipeline works fully offline without any key.

# ---- LLM (optional) -------------------------------------------------------
# Provider: "none" (rule-based, offline), "openai", or "ollama" (local).
CONTENTFORGE_LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Database (optional PostgreSQL) ---------------------------------------
# Leave empty to use SQLite at data/db/contentforge.sqlite3
CONTENTFORGE_DATABASE_URL=

# ---- Paths (optional overrides) -------------------------------------------
# CONTENTFORGE_CONFIG=config/config.yaml
# CONTENTFORGE_DATA_DIR=./data

# ---- Misc -----------------------------------------------------------------
CONTENTFORGE_LOG_LEVEL=INFO
